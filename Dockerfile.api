# Container-ready, though the free-tier deployment in DEPLOY.md does not need it.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY packages/engine/package.json packages/engine/
COPY apps/api/package.json apps/api/
RUN npm ci --workspaces --include-workspace-root
COPY packages/engine packages/engine
COPY apps/api apps/api
RUN npm run build:api

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/package.json package.json
COPY --from=build /app/packages/engine packages/engine
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/api/package.json apps/api/package.json
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:4000/api/health || exit 1
CMD ["node", "apps/api/dist/main.js"]
