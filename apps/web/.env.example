# Where the NestJS API lives. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: giving the web app its own key lets the degraded-mode engine
# (the Next.js route that takes over when the API is unreachable) keep
# generating real missions instead of falling back to the offline builder.
GEMINI_API_KEY=

# Degraded-mode engine (used only when the API is down). Off by default.
# If you turn it on, JWT_SECRET must equal the API's JWT_SECRET.
LOCAL_ENGINE_FALLBACK=false
JWT_SECRET=
