# ---------------------------------------------------------------- server
PORT=4000
NODE_ENV=development
APP_VERSION=1.0.0

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Allow *.vercel.app preview deployments (handy while iterating, turn off later).
ALLOW_VERCEL_PREVIEWS=false
# Only previews whose hostname starts with this prefix, e.g. sabaq-web-
VERCEL_PREVIEW_PREFIX=
# Proxy hops in front of the API (Render/Railway = 1)
TRUST_PROXY_HOPS=1

# ------------------------------------------------------------- security
# MUST be at least 16 characters. Generate one: openssl rand -base64 32
JWT_SECRET=
# ^ REQUIRED, 32+ chars. Generate: openssl rand -base64 48
JWT_TTL=8h
RATE_LIMIT_PER_MIN=120
MAX_UPLOAD_BYTES=26214400

# Seed accounts. Change the passwords before the demo.
ADMIN_EMAIL=admin@sabaq.app
# Set strong passwords. If blank, a random one is generated and printed in the log at boot.
ADMIN_PASSWORD=
LEARNER_EMAIL=learner@sabaq.app
LEARNER_PASSWORD=
# One-click Demo Learner + Demo Admin buttons on the sign-in page.
DEMO_LOGIN=true
# Set to false to hide only the Demo Admin button (recommended after the panel demo).
DEMO_ADMIN_LOGIN=true

# ------------------------------------------------------------- database
# Supabase: Project settings -> Database -> Connection string -> URI.
# Use the pooler host and add ?sslmode=require
# Leave blank to run on in-memory storage (everything still works, nothing persists).
DATABASE_URL=
# Creates/updates tables on boot. Set to false once the schema is stable.
DB_SYNC=true
DB_POOL_MAX=5

# ------------------------------------------------------------------- AI
# Tried in order; the first key that answers wins. Any one of these is enough
# to run. Two or more is what keeps a live demo alive when one rate-limits.
# With no keys at all the deterministic offline builder still serves learners
# from pasted text or an uploaded file.

# 1. Google AI Studio — aistudio.google.com/apikey  (Google sign-in, no card)
GEMINI_API_KEY=
# LEAVE THIS BLANK unless you have a reason. Pinning a model stops the engine
# from moving off one that is retired or overloaded. Blank = auto.
GEMINI_MODEL=

# 2. GitHub Models — github.com/settings/tokens (fine-grained token, scope: Models:read)
#    Easiest backup: no new signup, no card, you already have a GitHub account.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o-mini

# 3. OpenRouter — openrouter.ai/keys  (Google sign-in, no card)
#    Model left blank = the engine picks a working free model automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# 4. Groq — console.groq.com/keys  (use console.groq.com, sign in with Google)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 5. Cerebras — cloud.cerebras.ai  (free tier, very fast)
CEREBRAS_API_KEY=

# 6. Mistral — console.mistral.ai  (free tier)
MISTRAL_API_KEY=

# ---------------------------------------------------------------- cache
# Optional. Upstash / Redis Cloud free tier. Blank = in-memory cache.
# e.g. rediss://default:<password>@<host>:6379
REDIS_URL=
# Cached missions live this long (seconds). Diagrams: 30 days.
JOURNEY_CACHE_TTL_SEC=604800
# Languages translated in the background right after a mission is built, so the
# language toggle is instant. Empty = off (saves free-tier quota).
PREFETCH_LANGS=ur,mix,en
# Gemini hidden "thinking" is kept minimal for speed. Set to on to restore it.
GEMINI_THINKING=

# ---------------------------------------------------------------- email
# Gmail: enable 2FA, then create an App Password and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sabaq Reports <your@gmail.com>
REPORT_EMAIL_TO=
